{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: NixFodExporter",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/NixFodExporter/bin/Debug/net10.0/NixFodExporter.dll",
            "args": [
                "from-derivations",
                "output",
                "${workspaceFolder}/samples/derivation.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
